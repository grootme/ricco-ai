# RICCO AI Configuration
# Based on evo-ai with RICCO customizations

# API
API_TITLE=RICCO AI
API_VERSION=2.0.0
API_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
POSTGRES_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/ricco_ai

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_TIME=3600

# Encryption
ENCRYPTION_KEY=your-encryption-key-change-in-production

# RICCO ID Integration
RICCO_ID_URL=http://localhost:3000
RICCO_SHARED_SECRET=your-shared-secret-with-ricco-id
RICCO_ID_JWT_ISSUER=ricco-id

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
DEFAULT_MODEL=anthropic/claude-3.5-sonnet
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.7

# A2UI (Gemini for UI generation)
GEMINI_API_KEY=your-gemini-api-key
A2UI_CATALOG_VERSION=v0_9

# Vector Store
VECTOR_STORE_PROVIDER=chromadb
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Email
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=noreply@ricco.com

# MCP
MCP_SERVERS_DIR=./mcp_servers
MCP_MAX_CONCURRENT=10

# AI Engine
AI_ENGINE=adk

# Feature Flags
ENABLE_STREAMING=true
ENABLE_A2A=true
ENABLE_A2UI=true
