# RICCO AI - Monitoring Proxy
# Caddy reverse proxy for monitoring services

:80 {
    # Prometheus
    handle /prometheus/* {
        reverse_proxy prometheus:9090
    }

    # Grafana
    handle /grafana/* {
        reverse_proxy grafana:3000
    }

    # Alertmanager
    handle /alertmanager/* {
        reverse_proxy alertmanager:9093
    }

    # Jaeger
    handle /jaeger/* {
        reverse_proxy jaeger:16686
    }

    # Loki
    handle /loki/* {
        reverse_proxy loki:3100
    }

    # Default - Grafana
    handle {
        reverse_proxy grafana:3000
    }

    # Logging
    log {
        output stdout
        format json
    }
}
